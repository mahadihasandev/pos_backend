APP_NAME="POS SuperShop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Dhaka
APP_URL=http://localhost:8000

OCTANE_SERVER=frankenphp
FRANKENPHP_CONFIG="worker ./public/frankenphp-worker.php --nb-workers=16"

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_SSLMODE=prefer

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=pos_supershop_cache

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

FRONTEND_URL=https://pos-frontend-lovat-eight.vercel.app
SANCTUM_STATEFUL_DOMAINS=pos-frontend-lovat-eight.vercel.app,localhost:3000
